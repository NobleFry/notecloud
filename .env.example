# ─────────────────────────────────────────────────────────────────
# NoteCloud 环境变量模板
#   复制为 .env 后修改：  cp .env.example .env
#   .env 已被 .gitignore 忽略，永远不要提交真实密钥。
# ─────────────────────────────────────────────────────────────────

# ── 站点 ─────────────────────────────────────────────────────────
SITE_NAME=NoteCloud
NODE_ENV=development
TZ=Asia/Shanghai
API_PORT=3000
WEB_PORT=5173
# 前端地址，用于 CORS 白名单与邮件里的链接
WEB_ORIGIN=http://localhost:5173
# 后端公开地址（邮件里的验证/重置链接基于它生成）
API_PUBLIC_URL=http://localhost:3000

# ── 生产部署（docker-compose.prod.yml 会用到）────────────────────
# 浏览器访问的站点地址；生产必须改成真实域名，否则分享链接会指错
PUBLIC_URL=http://localhost:8080
# web 容器对外暴露的端口
HTTP_PORT=8080
# 容器启动时自动跑迁移；多副本部署时只让其中一份为 true
RUN_MIGRATIONS=true
# MySQL InnoDB buffer pool；1~2GB 内存的机器建议改成 256M
MYSQL_BUFFER_POOL=512M

# ── 数据库（由 docker compose 提供，与宿主机 MariaDB 隔离）───────
# ⚠️ 密码只使用字母和数字：它会被拼进 DATABASE_URL，
#    含 @ : / ? 等字符会破坏连接串（生产 compose 也是同样的约束）
MYSQL_PORT=3307
MYSQL_DATABASE=notecloud
MYSQL_USER=notecloud
MYSQL_PASSWORD=__CHANGE_ME__
MYSQL_ROOT_PASSWORD=__CHANGE_ME_ROOT__
DATABASE_URL="mysql://notecloud:__CHANGE_ME__@127.0.0.1:3307/notecloud"
# 集成测试库（由 deploy/compose/init/01-init.sql 创建）
# 同时被 Prisma 当作 migrate dev 的「影子库」（见 apps/api/prisma.config.ts）
TEST_DATABASE_URL="mysql://notecloud:__CHANGE_ME__@127.0.0.1:3307/notecloud_test"

# ── 认证 ─────────────────────────────────────────────────────────
# 生成方式： openssl rand -base64 48
JWT_SECRET=__GENERATE__
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d
# 是否允许同一账号多设备同时在线
ALLOW_MULTI_SESSION=true

# ── 注册策略（当前：邀请制）─────────────────────────────────────
# 默认关闭公开注册，只能通过工作区邀请链接进入。
# 例外：系统里一个用户都没有时，首次注册者自动成为站点管理员（首次启动引导）。
ALLOW_PUBLIC_REGISTRATION=false
# 邮箱验证：M1 阶段关闭（依赖 SMTP，见下方"邮件 —— 待办"）
REQUIRE_EMAIL_VERIFICATION=false
# 邮箱验证链接有效期（启用邮件验证后生效）
EMAIL_VERIFY_TTL=24h
PASSWORD_RESET_TTL=2h
# 邀请链接默认有效期与最大使用次数
INVITATION_TTL=7d
INVITATION_MAX_USES=1

# ── 邮件 —— 待办（TODO）─────────────────────────────────────────
# 当前 M1 走邀请链接，不需要发信，所以下面留空即可。
# 配置 SMTP 后需要做的事：
#   1) 把 REQUIRE_EMAIL_VERIFICATION 改成 true
#   2) 启用「忘记密码」邮件与「邮箱邀请」邮件
#   3) 配置发件域名的 SPF / DKIM，否则验证码邮件大概率进垃圾箱
#   4) 想先用本地邮件服务器验证模板：pnpm dev:mail（Mailpit，见 docs/DEV.md）
SMTP_HOST=
SMTP_PORT=465
# 465 用 true(隐式 TLS)，587 用 false(STARTTLS)
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
MAIL_FROM_NAME=NoteCloud
MAIL_FROM_ADDRESS=no-reply@example.com
# 发信频率限制（防止被当作垃圾邮件源）
MAIL_RATE_LIMIT_PER_HOUR=200

# 本地调试邮件模板时可临时切到 Mailpit（pnpm dev:mail）：
# SMTP_HOST=127.0.0.1
# SMTP_PORT=1025
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=

# ── 附件存储（默认本地磁盘）─────────────────────────────────────
# 存储层做了抽象，后续可切 S3/MinIO 而不改业务代码
STORAGE_DRIVER=local
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_MB=50

# ── 其他 ─────────────────────────────────────────────────────────
# 首个注册用户自动成为站点管理员
FIRST_USER_IS_ADMIN=true
LOG_LEVEL=debug
