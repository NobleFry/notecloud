# NoteCloud —— Nginx 配置模板
#
# 由官方 nginx 镜像的 docker-entrypoint 在启动时用 envsubst 渲染到
# /etc/nginx/conf.d/default.conf。
# 只有 ${API_UPSTREAM} 会被替换（模板里其它 $ 都是 nginx 变量）。
#
# 想上 HTTPS：见 deploy/nginx/https.conf.example

server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # 附件上传上限，要和 .env 的 MAX_UPLOAD_MB 对齐（留一点余量给 multipart 头）
    client_max_body_size 60m;

    # 基础安全头
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "geolocation=(), microphone=(), camera=()" always;

    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_proxied any;
    gzip_types text/plain text/css application/javascript application/json
               application/xml image/svg+xml;

    # ── 静态资源 ──────────────────────────────────────────────────
    # Vite 产物带内容 hash，可以长期缓存
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    # Service Worker 必须每次校验，否则用户永远拿到旧版本
    location = /sw.js {
        add_header Cache-Control "no-cache";
    }

    location = /manifest.webmanifest {
        add_header Cache-Control "no-cache";
    }

    # ── WebSocket（要放在 /api/ 之前语义上更清楚，nginx 按最长前缀匹配）──
    location /api/v1/ws {
        proxy_pass http://${API_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # 下面三行：API 的 Helmet 也会设这些头，不去重会出现两个同名头
        proxy_hide_header X-Content-Type-Options;
        proxy_hide_header X-Frame-Options;
        proxy_hide_header Referrer-Policy;
        # 长连接：断开心跳由服务端 30s 一次 ping 维持
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }

    # ── API 反代 ──────────────────────────────────────────────────
    location /api/ {
        proxy_pass http://${API_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # 同上：避免安全头重复
        proxy_hide_header X-Content-Type-Options;
        proxy_hide_header X-Frame-Options;
        proxy_hide_header Referrer-Policy;
        # 上传大文件 / 慢请求
        proxy_read_timeout 120s;
        proxy_send_timeout 120s;
    }

    # ── SPA 路由回退 ──────────────────────────────────────────────
    location / {
        try_files $uri $uri/ /index.html;
    }
}
